<%
// Homepage: first project as a wide feature card, the rest in a two-up grid.
//
// Gotchas this template works around, so please keep the shape:
//  * Output is re-parsed as markdown, so it must be ONE unindented line with no
//    blank lines. Indented HTML turns into a <pre><code> block.
//  * Use `outputHref` for links. `path` is the source path and on Windows it
//    contains a backslash (/projects\remote-sensing.qmd) which markdown then
//    mangles into a broken href.
const num = (it, i) => it.number || String(it.order || i + 1).padStart(2, "0");
const esc = (s) => String(s == null ? "" : s)
  .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const card = (it, i, isFeature) =>
  '<a class="' + (isFeature ? "project-feature" : "project-small") + '" href="' + esc(it.outputHref) + '">'
  + '<div class="project-image ' + esc(it["image-class"] || "satellite") + '">'
  + '<span class="project-number">' + num(it, i) + '</span>'
  + (isFeature ? '<div class="sat-grid"></div>' : '')
  + '</div>'
  + '<div class="project-info">'
  + '<div class="project-type">' + esc(it["project-type"]) + '</div>'
  + '<h3>' + esc(it.title) + '</h3>'
  + '<p>' + esc(it.description) + '</p>'
  + '<span class="arrow">' + (isFeature ? "Explore skill demo" : "Explore") + ' &#8599;</span>'
  + '</div></a>';

let html = "";
if (items.length) html += card(items[0], 0, true);
const rest = items.slice(1);
if (rest.length) {
  html += '<div class="project-grid">';
  rest.forEach((it, i) => { html += card(it, i + 1, false); });
  html += '</div>';
}
%><%= html %>
